# Server Configuration
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/lingovibe

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-here

# Stream Chat Configuration (if using Stream API)
STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret

# Frontend build configuration (the API key is public; never put the secret here)
VITE_STREAM_API_KEY=your-stream-api-key

# Comma-separated frontend origins allowed to send credentialed API requests
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development 